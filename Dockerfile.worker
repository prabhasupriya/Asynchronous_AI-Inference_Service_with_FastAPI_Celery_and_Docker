# ---------- Stage 1: builder ----------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt


# ---------- Stage 2: runtime ----------
FROM python:3.11-slim AS runtime

WORKDIR /app

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd --create-home --shell /bin/bash appuser

COPY app/ ./app/
COPY worker/ ./worker/
COPY ml/ ./ml/

RUN chown -R appuser:appuser /app
USER appuser

# Basic liveness check: `celery inspect ping` talks to the running worker.
HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=5 \
    CMD celery -A worker.celery_app inspect ping -d celery@$HOSTNAME || exit 1

CMD ["celery", "-A", "worker.celery_app", "worker", "--loglevel=info", "--concurrency=2"]

# Copy this file to `.env` and adjust values as needed.
# No real secrets are required for this project — Redis runs unauthenticated
# locally by default, which is fine for local/dev use only.

# --- Redis (message broker + Celery result backend) ---
# In docker-compose this is overridden to redis://redis:6379/0 automatically.
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- ML artifact paths (relative to project root) ---
MODEL_PATH=ml/artifacts/model.pkl
VECTORIZER_PATH=ml/artifacts/vectorizer.pkl

# --- Celery testing flag ---
# Set to "true" to run Celery tasks synchronously/in-process (used by tests).
CELERY_TASK_ALWAYS_EAGER=false
